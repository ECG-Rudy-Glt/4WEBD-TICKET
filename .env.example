# Global
JWT_SECRET=supersecretchangeInProd
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# Database Credentials
USER_DB_USER=user_user
USER_DB_PASSWORD=user_pass
USER_DB_NAME=user_db

EVENT_DB_USER=event_user
EVENT_DB_PASSWORD=event_pass
EVENT_DB_NAME=event_db

BOOKING_DB_USER=booking_user
BOOKING_DB_PASSWORD=booking_pass
BOOKING_DB_NAME=booking_db

PAYMENT_DB_USER=payment_user
PAYMENT_DB_PASSWORD=payment_pass
PAYMENT_DB_NAME=payment_db

NOTIF_DB_USER=notif_user
NOTIF_DB_PASSWORD=notif_pass
NOTIF_DB_NAME=notif_db

# Database URLs (Primary)
AUTH_DATABASE_URL=postgresql://${USER_DB_USER}:${USER_DB_PASSWORD}@user-db:5432/${USER_DB_NAME}
USER_DATABASE_URL=postgresql://${USER_DB_USER}:${USER_DB_PASSWORD}@user-db:5432/${USER_DB_NAME}
EVENT_DATABASE_URL=postgresql://${EVENT_DB_USER}:${EVENT_DB_PASSWORD}@event-db:5432/${EVENT_DB_NAME}
BOOKING_DATABASE_URL=postgresql://${BOOKING_DB_USER}:${BOOKING_DB_PASSWORD}@booking-db:5432/${BOOKING_DB_NAME}
PAYMENT_DATABASE_URL=postgresql://${PAYMENT_DB_USER}:${PAYMENT_DB_PASSWORD}@payment-db:5432/${PAYMENT_DB_NAME}
NOTIFICATION_DATABASE_URL=postgresql://${NOTIF_DB_USER}:${NOTIF_DB_PASSWORD}@notif-db:5432/${NOTIF_DB_NAME}

# Database URLs (Replica)
AUTH_DATABASE_REPLICA_URL=postgresql://${USER_DB_USER}:${USER_DB_PASSWORD}@user-db-replica:5432/${USER_DB_NAME}
USER_DATABASE_REPLICA_URL=postgresql://${USER_DB_USER}:${USER_DB_PASSWORD}@user-db-replica:5432/${USER_DB_NAME}
EVENT_DATABASE_REPLICA_URL=postgresql://${EVENT_DB_USER}:${EVENT_DB_PASSWORD}@event-db-replica:5432/${EVENT_DB_NAME}
BOOKING_DATABASE_REPLICA_URL=postgresql://${BOOKING_DB_USER}:${BOOKING_DB_PASSWORD}@booking-db-replica:5432/${BOOKING_DB_NAME}
PAYMENT_DATABASE_REPLICA_URL=postgresql://${PAYMENT_DB_USER}:${PAYMENT_DB_PASSWORD}@payment-db-replica:5432/${PAYMENT_DB_NAME}
NOTIFICATION_DATABASE_REPLICA_URL=postgresql://${NOTIF_DB_USER}:${NOTIF_DB_PASSWORD}@notif-db-replica:5432/${NOTIF_DB_NAME}

# Service URLs (Internal)
AUTH_URL=http://auth-lb:3011/auth
USER_URL=http://user-lb:3010/users
EVENT_URL=http://event-lb:3020/events
BOOKING_URL=http://booking-lb:3021/tickets

# Ports
PORT=3000
