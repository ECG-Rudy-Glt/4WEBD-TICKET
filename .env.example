# JWT
JWT_SECRET=super-secret-jwt-key-change-in-prod

# Auth DB
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=auth_pass
AUTH_DB_NAME=auth_db
AUTH_DATABASE_URL=postgresql://auth_user:auth_pass@auth-db:5432/auth_db
AUTH_DATABASE_REPLICA_URL=postgresql://auth_user:auth_pass@auth-db-replica:5432/auth_db

# Booking DB
BOOKING_DB_USER=booking_user
BOOKING_DB_PASSWORD=booking_pass
BOOKING_DB_NAME=booking_db
BOOKING_DATABASE_URL=postgresql://booking_user:booking_pass@booking-db:5432/booking_db
BOOKING_DATABASE_REPLICA_URL=postgresql://booking_user:booking_pass@booking-db-replica:5432/booking_db

# Payment DB
PAYMENT_DB_USER=payment_user
PAYMENT_DB_PASSWORD=payment_pass
PAYMENT_DB_NAME=payment_db
PAYMENT_DATABASE_URL=postgresql://payment_user:payment_pass@payment-db:5432/payment_db
PAYMENT_DATABASE_REPLICA_URL=postgresql://payment_user:payment_pass@payment-db-replica:5432/payment_db

# Notification DB
NOTIF_DB_USER=notif_user
NOTIF_DB_PASSWORD=notif_pass
NOTIF_DB_NAME=notif_db
NOTIF_DATABASE_URL=postgresql://notif_user:notif_pass@notif-db:5432/notif_db
NOTIF_DATABASE_REPLICA_URL=postgresql://notif_user:notif_pass@notif-db-replica:5432/notif_db

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# Redis
REDIS_URL=redis://redis:6379

# Service URLs (utilisées par l'api-gateway)
AUTH_URL=http://auth-lb:3010
BOOKING_URL=http://booking-lb:3020
PAYMENT_URL=http://payment-service:3005
NOTIFICATION_URL=http://notification-service:3002

# Paiement (optionnel)
SIMULATE_FAILURE_RATE=0
