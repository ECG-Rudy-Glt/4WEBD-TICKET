
JWT_SECRET=super-secret-jwt-key-change-in-prod

RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASS}@rabbitmq:5672

REDIS_URL=redis://redis:6379

REPLICATION_USER=replicator
REPLICATION_PASSWORD=replicator_pass

PATRONI_SUPERUSER_PASSWORD=postgres_pass

AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=auth_pass
AUTH_DB_NAME=auth_db

USER_DB_USER=user_user
USER_DB_PASSWORD=user_pass
USER_DB_NAME=user_db

EVENT_DB_USER=event_user
EVENT_DB_PASSWORD=event_pass
EVENT_DB_NAME=event_db

BOOKING_DB_USER=booking_user
BOOKING_DB_PASSWORD=booking_pass
BOOKING_DB_NAME=booking_db

PAYMENT_DB_USER=payment_user
PAYMENT_DB_PASSWORD=payment_pass
PAYMENT_DB_NAME=payment_db

NOTIF_DB_USER=notif_user
NOTIF_DB_PASSWORD=notif_pass
NOTIF_DB_NAME=notif_db

PGBOUNCER_PORT=6432
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_MAX_CLIENT_CONN=200
PGBOUNCER_DEFAULT_POOL_SIZE=20

AUTH_URL=http://auth-service:3004
USER_URL=http://user-service:3001
EVENT_URL=http://event-service:3006
BOOKING_URL=http://booking-service:3003
PAYMENT_URL=http://payment-service:3005
NOTIFICATION_URL=http://notification-service:3002

SIMULATE_FAILURE_RATE=0
